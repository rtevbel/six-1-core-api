# six1-core-api/Dockerfile.prod
# ---- Stage 1: Build ----
# (Node 16 kept per your request; swap to node:20-bookworm-slim when ready)
FROM node:16-bullseye AS builder

ENV NODE_ENV=development
ENV APP_DIR=/src/local/app
WORKDIR $APP_DIR

# Copy manifests first for better caching
COPY package*.json ./

# Install full deps for build (uses lockfile if present)
RUN if [ -f package-lock.json ]; then npm ci; else npm install; fi

# Copy source and build
COPY . .
RUN npm run build

# ---- Stage 2: Runtime (no extra apt packages) ----
FROM node:16-bullseye-slim

ENV NODE_ENV=production
ENV APP_USER=appuser
ENV APP_DIR=/src/local/app
WORKDIR $APP_DIR

# Create non-root user (no extra packages needed)
RUN groupadd -r $APP_USER && useradd -m -r -g $APP_USER $APP_USER

# Only production deps
COPY package*.json ./
RUN if [ -f package-lock.json ]; then npm ci --omit=dev; else npm install --omit=dev; fi

# Bring compiled app
COPY --from=builder $APP_DIR/dist ./dist

# Own the app directory and drop privileges
RUN chown -R $APP_USER:$APP_USER $APP_DIR
USER $APP_USER

# If your app listens on a port, you can expose it (optional)
# EXPOSE 3000

# Start (uses your package.json "start:prod": "node dist/main.js")
CMD ["npm", "run", "start:prod"]
